# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=

# Optional overrides (defaults shown)
# REALTIME_MODEL=gpt-realtime-2.1
# REALTIME_VOICE=marin
# TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# TEXT_MODEL=gpt-5.4-mini
# EMBED_MODEL=text-embedding-3-small
# TURN_DETECTION=server_vad        # or semantic_vad

# Identify yourself to the free OSM services (Nominatim policy asks for a contact).
HTTP_USER_AGENT=KumbhSahayakDemo/0.1 (contact: you@example.com)

# Set this when the app is publicly deployed so strangers can't spend your OpenAI credit.
DEMO_ACCESS_CODE=
